arr = [1, 2, 1, 2, 3]
k = 2
left=0
max_len=0
freq={}

for right in range(len(arr)):
    freq[arr[right]]=freq.get(arr[right],0)+1

    while len(freq)>k:
        freq[arr[left]]-=1
        if freq[arr[left]]==0:
            del freq[arr[left]]
        left+=1
    max_len=max(max_len,right-left+1)
print(max_len)
